{
  "name": "juego-de-juegos",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node online/rendezvous.mjs",
    "online:host": "node online/server.mjs",
    "online:rendezvous": "node online/rendezvous.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorLozano06/JuegoDeJuegos.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/VictorLozano06/JuegoDeJuegos/issues"
  },
  "homepage": "https://github.com/VictorLozano06/JuegoDeJuegos#readme",
  "private": true,
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "com.devempire3d.game",
    "productName": "Dev Empire 3D",
    "files": [
      "dist/**/*",
      "electron-main.js"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Dev-Empire-3D-Windows.exe"
    }
  }
}
